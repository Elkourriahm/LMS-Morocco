# Modèle des variables d'environnement, validées par zod dans src/env.ts au
# démarrage (next dev / build / start). Copier vers .env.local pour un usage
# local. Ne jamais committer de valeur réelle : seul ce fichier est versionné.

# Environnement applicatif : development | test | production.
# Facultatif en local : à défaut, NODE_ENV est utilisé.
APP_ENV=development

# Origine publique de l'application (publique, exposée au navigateur), sans
# « / » final. Sert aux liens envoyés par email (réinitialisation du mot de
# passe) ; doit figurer dans additional_redirect_urls de supabase/config.toml.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Nom affiché de l'application (public, exposé au navigateur).
# Facultatif : « LMS Maroc » par défaut.
NEXT_PUBLIC_APP_NAME=LMS Maroc

# --- Supabase ---------------------------------------------------------------
# Valeurs LOCALES PAR DÉFAUT de `pnpm db:start` (Supabase CLI), identiques sur
# tous les postes et publiées dans la documentation de Supabase : ce ne sont
# pas des secrets et elles ne donnent accès qu'à la base locale (Docker).
# Les afficher : `pnpm exec supabase status -o env`. Ne jamais mettre ici les
# clés d'un projet Supabase distant.

# URL de l'API Supabase (publique, exposée au navigateur).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clé anon (publique, exposée au navigateur) : soumise à la RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Clé service_role : SERVEUR UNIQUEMENT, contourne la RLS (ADR 0006).
# Jamais de préfixe NEXT_PUBLIC_ (refusé par src/env.ts). Absente du bundle
# client : vérifié après chaque `pnpm build`.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
