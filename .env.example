# Modèle des variables d'environnement, validées par zod dans src/env.ts au
# démarrage (next dev / build / start). Copier vers .env.local pour un usage
# local. Ne jamais committer de valeur réelle : seul ce fichier est versionné.

# Environnement applicatif : development | test | production.
# Facultatif en local : à défaut, NODE_ENV est utilisé.
APP_ENV=development

# Nom affiché de l'application (public, exposé au navigateur).
# Facultatif : « LMS Maroc » par défaut.
NEXT_PUBLIC_APP_NAME=LMS Maroc
