{
  "name": "lms-morocco",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^24.11.0",
    "pnpm": ">=12.9.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm check:bundle",
    "start": "next start",
    "lint": "pnpm i18n:check && pnpm db:check-rollbacks && eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/i18n-check.mts",
    "check:bundle": "node scripts/check-client-bundle.mts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:new": "node scripts/db-new.mts",
    "db:types": "node scripts/db-types.mts",
    "db:test": "supabase test db --local",
    "db:rollback-check": "node scripts/db-rollback-check.mts",
    "db:check-rollbacks": "node scripts/db-check-rollbacks.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "prettier": "3.9.9",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
